# Generate the authoritative Mailu compose files at https://setup.mailu.io/.
# This file documents the values this portal expects you to align.

DOMAIN=yourdomain.com
HOSTNAMES=mail.yourdomain.com
POSTMASTER=postmaster
TLS_FLAVOR=letsencrypt
API=true
WEB_API=/api
API_TOKEN=replace-with-long-random-api-token

# Keep signup public access disabled in Mailu itself. The portal owns invites.
REGISTRATION=false
