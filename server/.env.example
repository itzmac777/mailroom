APP_SECRET=change-this-to-a-long-random-secret
PORT=4000
CLIENT_ORIGIN=http://localhost:3000

MAIL_DOMAIN=yourdomain.com
MAIL_HOSTNAME=mail.yourdomain.com
WEBMAIL_URL=https://mail.yourdomain.com/webmail/

MAILU_API_BASE=https://mail.yourdomain.com
MAILU_API_TOKEN=replace-with-mailu-api-token
MAILU_CREATE_USER_ENDPOINT=/api/v1/user
MAILU_DRY_RUN=true

ADMIN_TOKEN=change-this-admin-token
DATA_DIR=./data
DATABASE_URL=file:./data/db.json

DEFAULT_QUOTA_MB=1024
DEFAULT_OUTBOUND_DAILY_LIMIT=50
