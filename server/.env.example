APP_SECRET=change-this-to-a-long-random-secret
ROTATOR_SESSION_KEY=change-this-to-a-separate-long-random-rotator-secret
ROTATOR_ONBOARDING_MAX_ITEMS=10
# Required when MAILU_DRY_RUN=false for browser-created site aliases.
ROTATOR_ALIAS_OWNER_EMAIL=you@yourdomain.com
PORT=4000
CLIENT_ORIGIN=http://localhost:3000

MAIL_DOMAIN=yourdomain.com
MAIL_HOSTNAME=mail.yourdomain.com
WEBMAIL_URL=https://mail.yourdomain.com/webmail/

MAILU_API_BASE=https://mail.yourdomain.com
MAILU_API_TOKEN=replace-with-mailu-api-token
MAILU_CREATE_USER_ENDPOINT=/api/v1/user
MAILU_DELETE_USER_ENDPOINT=/api/v1/user
MAILU_ALIAS_ENDPOINT=/api/v1/alias
MAILU_UPDATE_USER_ENDPOINT=/api/v1/user
MAILU_DRY_RUN=true

ADMIN_TOKEN=change-this-admin-token
DATA_DIR=./data
DATABASE_URL=file:./data/db.json

DEFAULT_QUOTA_MB=1024
DEFAULT_OUTBOUND_DAILY_LIMIT=50
DEFAULT_ALIAS_LIMIT=5
ALIAS_FORWARD_LIMIT=3
TEMP_MAIL_ENABLED=false
TEMP_QUOTA_MB=128

SMTP_HOST=mail.yourdomain.com
SMTP_PORT=465
SMTP_SECURE=true

# Required for /temp/inbox forwarding when the fetched inbox is external
# (Gmail, Outlook, etc.). Use a mailbox that can authenticate to SMTP_HOST.
TEMP_INBOX_FORWARD_FROM_EMAIL=
TEMP_INBOX_FORWARD_FROM_PASSWORD=

# Optional: used first for automated rotator onboarding of local mailboxes.
# If master-user auth is unavailable, Mailroom falls back to resetting the
# target mailbox password through MAILU_UPDATE_USER_ENDPOINT and stores the
# generated password encrypted with ROTATOR_SESSION_KEY.
# ROTATOR_ZENVY_IMAP_AUTH_FORMAT supports {email}, {local}, and {masterUser}.
ROTATOR_ZENVY_IMAP_MASTER_USER=
ROTATOR_ZENVY_IMAP_MASTER_PASSWORD=
ROTATOR_ZENVY_IMAP_AUTH_FORMAT={email}*{masterUser}

